# QueryPilot runs on free local models through Ollama by default.
# Install the models once:  ollama pull qwen2.5-coder:7b  and  ollama pull qwen2.5-coder:3b
QP_PROVIDER=ollama
# QP_LARGE_MODEL=qwen2.5-coder:7b
# QP_SMALL_MODEL=qwen2.5-coder:3b
# QP_NUM_CTX=16384
# OLLAMA_URL=http://localhost:11434

# Optional: Google Gemini (free tier, rate-limited). Get a key at https://aistudio.google.com
# GEMINI_API_KEY=
# QP_GEMINI_LARGE=gemini-3.5-flash-lite
# QP_GEMINI_RPM=14

# Optional: use the paid Mistral API instead
# QP_PROVIDER=mistral
# MISTRAL_API_KEY=

# QP_RATE_LIMIT_PER_HOUR=20
